{
  "name": "mininet-in-the-browser",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "dev": "yarn prepare:assets && vite",
    "build": "yarn typecheck && yarn prepare:assets && vite build && node scripts/verify-assets.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "prepare:assets": "node scripts/vendor-assets.mjs",
    "test:vm": "node scripts/smoke-vm.cjs",
    "build:guest": "bash scripts/build-guest.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "v86": "0.5.381",
    "vite": "8.3.1",
    "wrangler": "4.138.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
