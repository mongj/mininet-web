#!/bin/sh
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /dev /proc /sys
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /run/openvswitch /var/run/openvswitch
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
hostname mininet-web
ip link set lo up
modprobe veth
modprobe bridge
modprobe openvswitch
modprobe sch_netem
modprobe 8021q
modprobe dummy
modprobe af_packet
modprobe iptable_nat
modprobe iptable_filter
modprobe xt_MASQUERADE
modprobe 9pnet_virtio
modprobe 9p
ovsdb-tool create /etc/openvswitch/conf.db /usr/share/openvswitch/vswitch.ovsschema
ovsdb-server --remote=punix:/var/run/openvswitch/db.sock --pidfile --detach
ovs-vsctl --no-wait init
ovs-vswitchd --pidfile --detach
mkdir -p /root/playground
# Serial1 bytes match the SERIAL1_* constants in src/vm/emulator.worker.ts.
# msize must match P9_MSIZE in src/vm/9p/constants.ts; host9p is v86's default virtio 9p mount tag.
if mount -t 9p -o trans=virtio,version=9p2000.L,cache=none,msize=8192 host9p /root/playground 2>/dev/null; then
  printf '\002' >/dev/ttyS1
else
  printf '\003' >/dev/ttyS1
fi
if [ ! -e /root/playground/.mininet-web-seeded ]; then
  cp -a /usr/share/mininet-web/skel/. /root/playground/
  : >/root/playground/.mininet-web-seeded
fi
export TERM=xterm-256color
export PS1='\n\h:\w\$ '
export HOME=/root
cd "$HOME/playground"
clear
echo "Linux is ready. Mininet and Open vSwitch are installed in this guest."
cat <<'EOF'

Demo network (hosts h1 and h2, switch s1):
  python3 lab.py

That opens the Mininet CLI. Try nodes, net, pingall, and help.
exit returns to this shell.

Or start your own topology:
  mn --switch ovsbr --controller none --topo single,2
EOF

# Ready signal (SERIAL1_READY in src/vm/emulator.worker.ts), sent after the mount result.
printf '\001' >/dev/ttyS1

while true; do
  setsid --ctty /bin/bash --noprofile --norc </dev/ttyS0 >/dev/ttyS0 2>&1 || true
  echo "Restarting the Linux console."
done
