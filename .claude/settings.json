{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just setup)",
      "Bash(just check)",
      "Bash(just verify)",
      "Bash(just --list *)",
      "Bash(just web typecheck *)",
      "Bash(just web lint *)",
      "Bash(just web test *)",
      "Bash(just web format *)",
      "Bash(just web format-check *)",
      "Bash(just web build)",
      "Bash(just web prepare-assets)",
      "Bash(just web shadcn *)",
      "Bash(just guest test)",
      "Bash(just cf deploy-check *)",
      "Bash(just cf preview *)",
      "Bash(just worktree list)",
      "Bash(just worktree path *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(yarn deploy *)",
      "Bash(yarn wrangler *)",
      "Bash(wrangler deploy *)",
      "Bash(wrangler login *)",
      "Bash(just cf deploy *)",
      "Bash(just cf login *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars*)"
    ]
  }
}
