{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn verify)",
      "Bash(yarn verify:fast)",
      "Bash(yarn typecheck *)",
      "Bash(yarn lint *)",
      "Bash(yarn test *)",
      "Bash(yarn format *)",
      "Bash(yarn format:check *)",
      "Bash(yarn build)",
      "Bash(yarn test:vm)",
      "Bash(yarn deploy:check)",
      "Bash(yarn install --immutable)",
      "Bash(just --list *)",
      "Bash(just check)",
      "Bash(just verify)",
      "Bash(just web typecheck *)",
      "Bash(just web lint *)",
      "Bash(just web test *)",
      "Bash(just web format *)",
      "Bash(just web format-check *)",
      "Bash(just web build)",
      "Bash(just guest test)",
      "Bash(just worktree list)",
      "Bash(just worktree path *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(yarn deploy *)",
      "Bash(yarn wrangler *)",
      "Bash(wrangler deploy *)",
      "Bash(just cf deploy *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars*)"
    ]
  }
}
